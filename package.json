{
  "name": "drange",
  "version": "2.0.1",
  "description": "For adding, subtracting, and indexing discontinuous ranges of numbers",
  "keywords": [
    "discontinuous",
    "range",
    "set"
  ],
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "nyc --extension .ts --reporter=lcov --reporter=text-summary npm run test:unit",
    "test:unit": "mocha --require ts-node/register test/*-test.ts",
    "test:types": "npm run build && tsc -p test/types"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fent/node-drange.git"
  },
  "author": "fent <fentbox@gmail.com> (https://github.com/fent)",
  "contributors": [
    "fent (https://github.com/fent)"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "mocha": "^12.0.3",
    "nyc": "^18.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "license": "MIT"
}

    "test:types": "tsc -p types"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fent/node-drange.git"
  },
  "author": "fent <fentbox@gmail.com> (https://github.com/fent)",
  "contributors": [
    "fent (https://github.com/fent)"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "mocha": "^12.0.3",
    "nyc": "^18.0.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=6"
  },
  "license": "MIT",
  "types": "./types"
